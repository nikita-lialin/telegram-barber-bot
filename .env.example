# Комментарии только на отдельных строках: docker --env-file не вырезает их после значения.

# Токен от @BotFather (обязательно)
BOT_TOKEN=

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Папка с сессиями (язык пользователей). В Docker задана в образе: /app/sessions
SESSION_DIR=./sessions
